{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
